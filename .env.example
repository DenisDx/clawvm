# Copy this file to .env before starting ClawVM. Keep .env private and use
# shell-compatible KEY=value entries only.

# OpenClaw Gateway
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token
# OPENCLAW_GATEWAY_PASSWORD=

# OpenClaw portable paths
OPENCLAW_HOME=/home/clawvm/.openclaw
# OPENCLAW_STATE_DIR=/home/clawvm/.openclaw
# OPENCLAW_INCLUDE_ROOTS=

# OpenClaw maintenance overrides. Leave disabled unless explicitly needed.
# OPENCLAW_ALLOW_OLDER_BINARY_DESTRUCTIVE_ACTIONS=
# OPENCLAW_NIX_MODE=

# ClawVM HTTPS proxy
CLAWVM_HTTPS_BIND_HOST=127.0.0.1
CLAWVM_HTTPS_HOST=127.0.0.1
CLAWVM_HTTPS_PORT=8880
CLAWVM_HTTPS_HOST_PORT=8880

# ClawVM runtime
PLAYWRIGHT_SHM_SIZE=1gb
TZ=UTC